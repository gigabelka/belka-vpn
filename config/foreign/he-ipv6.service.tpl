# Generated by belka-vpn install-foreign.sh. Do not edit by hand.
# Hurricane Electric 6in4 tunnel: IPv6 egress for Google (GOOGLE_IPV6_EGRESS=1).
[Unit]
Description=belka-vpn Hurricane Electric 6in4 tunnel (IPv6 egress for Google)
After=network-online.target
Wants=network-online.target
Before=xray.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-ip tunnel del he-ipv6
ExecStart=ip tunnel add he-ipv6 mode sit remote ${HE_SERVER_IPV4} local ${FOREIGN_PUBLIC_IP} ttl 255
ExecStart=ip link set he-ipv6 up mtu 1480
ExecStart=ip -6 addr add ${HE_CLIENT_IPV6} dev he-ipv6
ExecStart=ip -6 route replace ::/0 dev he-ipv6
ExecStop=-ip tunnel del he-ipv6

[Install]
WantedBy=multi-user.target
