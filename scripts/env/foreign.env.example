# /etc/belka-vpn/foreign.env — FOREIGN server settings.
# Public data only: no private keys, passwords or tokens.
# Fill in the real IPs (or run scripts/configure.sh).

FOREIGN_PUBLIC_IP=
RU_PUBLIC_IP=

AWG_PORT=443
TUNNEL_NET=172.16.0.0/24
FOREIGN_TUNNEL_IP=172.16.0.1
RU_TUNNEL_IP=172.16.0.2
AWG_MTU=1280
SOCKS_PORT=1080
SSH_PORT=22

ENABLE_UFW=1
ENABLE_FAIL2BAN=1
AWG_ENABLE_S3S4=0
HARDEN_SSH=0

# Google domains (geosite:google) leave over IPv6 instead of IPv4, for when
# Google's own geo database places the IPv4 exit in Russia (Gemini blocked).
# Native IPv6: set only GOOGLE_IPV6_EGRESS=1. No native IPv6: create a free
# tunnel at tunnelbroker.net and copy "Server IPv4 Address" and
# "Client IPv6 Address" (with /64) here.
GOOGLE_IPV6_EGRESS=0
HE_SERVER_IPV4=
HE_CLIENT_IPV6=
