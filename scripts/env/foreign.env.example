# /etc/belka-vpn/foreign.env — FOREIGN server settings.
# Public data only: no private keys, passwords or tokens.
# Fill in the real IPs (or run scripts/configure.sh).

FOREIGN_PUBLIC_IP=
RU_PUBLIC_IP=

AWG_PORT=443
TUNNEL_NET=172.16.0.0/24
FOREIGN_TUNNEL_IP=172.16.0.1
RU_TUNNEL_IP=172.16.0.2
AWG_MTU=1280
SOCKS_PORT=1080
SSH_PORT=22

ENABLE_UFW=1
ENABLE_FAIL2BAN=1
AWG_ENABLE_S3S4=0
HARDEN_SSH=0
