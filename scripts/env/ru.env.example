# /etc/belka-vpn/ru.env — RU server settings.
# Public data only: no private keys, passwords or tokens.
# Fill in the real IPs (or run scripts/configure.sh).

RU_PUBLIC_IP=
FOREIGN_PUBLIC_IP=

AWG_PORT=443
TUNNEL_NET=172.16.0.0/24
FOREIGN_TUNNEL_IP=172.16.0.1
RU_TUNNEL_IP=172.16.0.2
AWG_MTU=1280
SOCKS_PORT=1080
SSH_PORT=22

ENABLE_UFW=0            # Hiddify Manager manages iptables on RU
ENABLE_FAIL2BAN=1
INSTALL_HIDDIFY=1
HIDDIFY_INSTALL_URL=https://i.hiddify.com/release
HARDEN_SSH=0
RU_IP_FORWARD=0         # 1 only for Hiddify's WireGuard/WARP (they need IP forwarding)
REALITY_SNI=www.microsoft.com

# Handoff file produced by install-foreign.sh and copied here.
FOREIGN_HANDOFF_FILE=/etc/belka-vpn/foreign-handoff.env
