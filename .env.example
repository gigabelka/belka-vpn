# belka-vpn variable reference (all roles). No script reads .env directly:
# the installers read /etc/belka-vpn/<role>.env. To generate those files from
# this list, copy it to .env (gitignored), fill it in and run:
#   set -a; . ./.env; set +a
#   bash scripts/configure.sh --non-interactive --role both --output-dir <dir outside the repo>
# Never commit .env.
#
# Server roles:
#   RU — public entry point for Hiddify app + routing
#   FOREIGN — internet egress for selected services

# Required
RU_PUBLIC_IP=
FOREIGN_PUBLIC_IP=

# AmneziaWG tunnel (UDP)
AWG_PORT=443
TUNNEL_NET=172.16.0.0/24
FOREIGN_TUNNEL_IP=172.16.0.1
RU_TUNNEL_IP=172.16.0.2
AWG_MTU=1280

# FOREIGN SOCKS egress (reachable only over the AmneziaWG tunnel)
SOCKS_PORT=1080

# SSH
SSH_PORT=22

# Reality SNI candidate. Verify with the Hiddify scanner before use.
REALITY_SNI=www.microsoft.com

# Behaviour
ENABLE_UFW=1            # FOREIGN only; RU leaves firewall to Hiddify Manager
ENABLE_FAIL2BAN=1
INSTALL_HIDDIFY=1
HIDDIFY_INSTALL_URL=https://i.hiddify.com/release
HARDEN_SSH=0            # enable only after key-based SSH access is verified
RU_IP_FORWARD=0         # RU only; 1 only for Hiddify's WireGuard/WARP (they need IP forwarding)
AWG_ENABLE_S3S4=0       # set 1 only if both peers run AmneziaWG 2.x+ and accept S3/S4
